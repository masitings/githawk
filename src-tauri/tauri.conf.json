{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHawk",
  "version": "0.1.1",
  "identifier": "app.githawk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitHawk",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "githawk"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxOEI2OTQ4QzQ3MEE5NzgKUldSNHFYREVTR21MVVlXc3BBUENSbVR5Z3hJOGNqN0d5S2V1WWs2MmF6eEZqRklpY2JuRnF3NFoK",
      "endpoints": [
        "https://github.com/masitings/githawk/releases/latest/download/latest.json"
      ]
    }
  }
}
